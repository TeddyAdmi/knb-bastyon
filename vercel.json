{
  "routes": [
    {
      "src": "/b_manifest",
      "dest": "/b_manifest.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ]
}